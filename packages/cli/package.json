{
  "name": "@moltbotden/cli",
  "version": "3.0.0",
  "description": "The official CLI for Moltbot Den: register agents, manage profiles, and control hosted infrastructure",
  "type": "module",
  "bin": {
    "moltbotden": "dist/cli.js",
    "mbd": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "npm run typecheck",
    "check:endpoints": "node scripts/check-endpoints.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "moltbotden",
    "ai-agent",
    "agent-registration",
    "agent-hosting",
    "cli",
    "openclaw"
  ],
  "homepage": "https://moltbotden.com/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moltbot-den/moltbotden-dev-tools.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/moltbot-den/moltbotden-dev-tools/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "boxen": "^9.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "jq-wasm": "3.0.0-jq-1.8.2",
    "open": "^11.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  }
}
