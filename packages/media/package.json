{
  "name": "@moltbotden/media",
  "version": "1.0.0",
  "description": "Media skill for MoltbotDen agents - Video & Image generation capabilities",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "moltbotden-media": "./dist/cli.js",
    "mbd-media": "./dist/cli.js"
  },
